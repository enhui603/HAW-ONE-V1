# Copy this into Streamlit Cloud: App > Settings > Secrets  (never upload real passwords to GitHub)

# Password for the team page (open the app with ?team=1)
team_password = "choose-a-long-password"

# Email sending (needed for visitor OTP and forgot-password emails).
# Without this the app runs in DEMO MODE and shows the code on screen instead of emailing it.
[smtp]
host = "smtp.gmail.com"
port = 587
user = "yourapp@gmail.com"
password = "your-gmail-app-password"
from = "HAW-ONE <yourapp@gmail.com>"
